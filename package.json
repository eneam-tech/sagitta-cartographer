{
  "name": "map-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run typecheck && npm run test && npm run test:e2e",
    "preview": "vite preview",
    "cf:types": "wrangler types worker/worker-configuration.d.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.1.0",
    "@fontsource/spectral": "^5.1.0",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "konva": "^9.3.18",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.167.0"
  }
}
